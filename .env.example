# Copy to .env and fill in. Never commit real values.
TRELLO_API_KEY=your-trello-api-key
TRELLO_TOKEN=your-trello-token
TRELLO_BOARD_ID=your-24-char-board-id
# Optional: a read-only GitHub token, only for getOutcomeAudit with verifyPullRequests
GITHUB_TOKEN=

# Optional: Collaboration Hub (set COLLAB_ENABLED=false to disable)
COLLAB_ENABLED=true
COLLAB_HUB_URL=http://127.0.0.1:8787
HUB_BRIDGE_TOKEN=replace-with-long-random-secret
# Optional: stable developer identity (otherwise a UUID is kept in .collaboration-dev-id)
# COLLAB_DEVELOPER_ID=your-name
# Optional: refuse Trello writes when the hub is unreachable (default: continue standalone)
# COLLAB_REQUIRE_HUB=true
